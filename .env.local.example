# 复制为 .env.local 后填入你自己的 Convex deployment 信息：
#
#   cp .env.local.example .env.local
#
# .env.local 已在 .gitignore 中，不会被提交。Vite 只把 VITE_ 前缀的变量
# 内联进前端产物，因此这里的值对浏览器是公开的——不要放密钥。

# 供 `npx convex dev` / `npx convex deploy` 选择要操作哪个 deployment。
CONVEX_DEPLOYMENT=dev:your-deployment-name

# 客户端实际连接的两个后端，覆盖 src/backend.ts 里内置的默认值。
VITE_CONVEX_URL_DEV=https://your-dev-deployment.convex.cloud
VITE_CONVEX_URL_PROD=https://your-prod-deployment.convex.cloud

# 下面这个是遗留项：客户端已不再读取（改它不会切换后端），
# 仅 scripts/project-snapshot.mjs 还用它做一次前置校验。
VITE_CONVEX_URL=https://your-dev-deployment.convex.cloud

# 当前没有任何代码引用，保留仅为兼容既有 .env.local。
VITE_CONVEX_SITE_URL=https://your-dev-deployment.convex.site
